{
  "git": {
    "deploymentEnabled": true
  },
  "rewrites": [
    {
      "source": "/inventory/:carId",
      "destination": "/car.html?car=:carId"
    },
    {
      "source": "/inventory",
      "destination": "/inventory.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/appointments",
      "destination": "/appointments.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/mercedes",
      "destination": "/mercedes.html"
    },
    {
      "source": "/mbac-control-7x4k9",
      "destination": "/mbac-control-7x4k9-login.html"
    },
    {
      "source": "/mbac-control-7x4k9/portal",
      "destination": "/mbac-control-7x4k9-portal.html"
    }
  ]
}
